# Core deployment
CORS_ORIGINS=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-secret

# Persistence: omit DATABASE_URL for local SQLite.
# Railway PostgreSQL example is injected by Railway when a Postgres service is attached.
DATABASE_URL=
HYDROSAFE_DB_PATH=backend/database/hydrosafe.db

# Grounded AI report enhancement. Keep the real key out of Git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
